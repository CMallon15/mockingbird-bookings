{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mockingbird-bookings",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/text/*", "/flyer/*"]
  },
  "vars": {
    "AIRTABLE_BASE": "appoA53P6VEXzkDoc",
    "ALLOWED_ORIGIN": "https://bookings.eatmorerhinestones.com",
    "TUNEHATCH_SMS": ""
  },
  "routes": [
    { "pattern": "bookings.eatmorerhinestones.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
